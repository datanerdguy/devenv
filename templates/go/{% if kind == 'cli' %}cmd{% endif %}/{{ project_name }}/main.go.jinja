// Command {{ project_name }}{% if description %}: {{ description }}{% endif %}.
package main

import (
	"flag"
	"fmt"

	"{{ go_module }}/internal/greet"
)

// version é trocada no build: go build -ldflags "-X main.version=v1.0.0".
var version = "dev"

func main() {
	name := flag.String("name", "mundo", "quem cumprimentar")
	showVersion := flag.Bool("version", false, "mostra a versão")
	flag.Parse()

	if *showVersion {
		fmt.Println(version)
		return
	}
	fmt.Println(greet.Hello(*name))
}

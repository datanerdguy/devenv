# Atualizações semanais das dependências, num PR por ecossistema.
version: 2
updates:
  - package-ecosystem: uv
    directory: /
    schedule:
      interval: weekly
    groups:
      python:
        patterns: ["*"]
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    groups:
      actions:
        patterns: ["*"]
{%- if docker %}
  - package-ecosystem: docker
    directory: /
    schedule:
      interval: weekly
{%- endif %}

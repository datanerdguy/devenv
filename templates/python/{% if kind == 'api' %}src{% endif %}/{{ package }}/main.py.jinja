"""API. Rode com `just dev` e veja a documentação em http://localhost:8000/docs."""

from typing import Annotated

from fastapi import Depends, FastAPI, HTTPException
from pydantic import BaseModel

from {{ package }}.settings import Settings, get_settings

app = FastAPI(title="{{ project_name }}")


class Item(BaseModel):
    id: int
    name: str


# Exemplo em memória; troque por um banco de verdade.
ITEMS: dict[int, Item] = {}


@app.get("/health")
def health(settings: Annotated[Settings, Depends(get_settings)]) -> dict[str, str]:
    return {"status": "ok", "app": settings.app_name}


@app.get("/items")
def list_items() -> list[Item]:
    return list(ITEMS.values())


@app.post("/items", status_code=201)
def create_item(item: Item) -> Item:
    if item.id in ITEMS:
        raise HTTPException(status_code=409, detail="item já existe")
    ITEMS[item.id] = item
    return item


@app.get("/items/{item_id}")
def get_item(item_id: int) -> Item:
    if item_id not in ITEMS:
        raise HTTPException(status_code=404, detail="item não encontrado")
    return ITEMS[item_id]

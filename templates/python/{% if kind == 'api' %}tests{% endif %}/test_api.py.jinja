from collections.abc import Iterator

import pytest
from fastapi.testclient import TestClient

from {{ package }}.main import ITEMS, app


@pytest.fixture
def client() -> Iterator[TestClient]:
    ITEMS.clear()
    with TestClient(app) as c:
        yield c


def test_health(client: TestClient) -> None:
    assert client.get("/health").json()["status"] == "ok"


def test_create_and_get(client: TestClient) -> None:
    assert client.post("/items", json={"id": 1, "name": "a"}).status_code == 201
    assert client.get("/items/1").json() == {"id": 1, "name": "a"}
    assert client.post("/items", json={"id": 1, "name": "a"}).status_code == 409
    assert client.get("/items/2").status_code == 404

//! Testa o programa compilado, como quem usa pela linha de comando.

use std::process::Command;

fn run(args: &[&str]) -> String {
    let out = Command::new(env!("CARGO_BIN_EXE_{{ project_name }}"))
        .args(args)
        .output()
        .expect("o programa roda");
    assert!(out.status.success());
    String::from_utf8(out.stdout).expect("saída em UTF-8")
}

#[test]
fn greets_by_name() {
    assert_eq!(run(&["--name", "Lucas"]), "Olá, Lucas!\n");
}

#[test]
fn greets_the_world_by_default() {
    assert_eq!(run(&[]), "Olá, mundo!\n");
}

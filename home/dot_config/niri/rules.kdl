// Regras de janela e de painel.

// Cantos arredondados e blur atrás das janelas.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    background-effect {
        blur true
        xray false
    }
}

// Ajustes do Noctalia e o anotador de capturas abrem flutuando.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id="com.gabm.satty"
    open-floating true
}

// Lista de temas (Super+T): janela pequena e flutuante.
window-rule {
    match app-id="dev.devenv.theme"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

// O papel de parede do Noctalia fica atrás de tudo, inclusive na visão geral.
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// Barra, notificações e painéis com blur do que está atrás, não do papel de parede.
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

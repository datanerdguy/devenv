# sway: sessão alternativa ao niri, com o mesmo Noctalia e os mesmos atalhos.
# Ligada em ~/.config/sway. Recarregar: Super+Shift+c.
include ~/.config/devenv/wm-common.conf
# Cores do tema atual (comando `theme`).
include ~/.local/state/devenv/theme/current/wm-colors.conf

input type:keyboard {
    xkb_layout us
    xkb_variant altgr-intl
    repeat_delay 250
    repeat_rate 40
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# Noctalia (barra, launcher, notificações, bloqueio)
exec noctalia
bindsym $mod+space exec noctalia msg panel-toggle launcher
bindsym $mod+s exec noctalia msg panel-toggle control-center
bindsym $mod+comma exec noctalia msg settings-toggle
bindsym $mod+Ctrl+v exec noctalia msg panel-toggle clipboard
bindsym $mod+Alt+l exec noctalia msg session lock
bindsym XF86AudioRaiseVolume exec noctalia msg volume-up
bindsym XF86AudioLowerVolume exec noctalia msg volume-down
bindsym XF86AudioMute exec noctalia msg volume-mute
bindsym XF86MonBrightnessUp exec noctalia msg brightness-up
bindsym XF86MonBrightnessDown exec noctalia msg brightness-down

bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaymsg exit

xwayland enable
for_window [app_id="dev.noctalia.Noctalia"] floating enable
for_window [app_id="dev.devenv.theme"] floating enable, resize set 900 420

# Monitores e ajustes desta máquina (fora do git).
include ~/.config/devenv/sway-local.conf

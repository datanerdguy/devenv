# i3 (X11): plano B para quando o Wayland não servir (alguns apps de captura,
# drivers antigos). Sem Noctalia (ele não roda em X11): barra i3status-rust, launcher rofi.
# Ligada em ~/.config/i3. Recarregar: Super+Shift+c.
include ~/.config/devenv/wm-common.conf
# Cores do tema atual (comando `theme`); a barra usa as variáveis $theme_*.
include ~/.local/state/devenv/theme/current/wm-colors.conf
for_window [class="dev.devenv.theme"] floating enable, resize set 900 420

font pango:JetBrainsMono Nerd Font 10

bindsym $mod+space exec rofi -show drun
bindsym $mod+Alt+l exec i3lock -c 2d353b
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym Print exec flameshot gui
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec i3-msg exit

exec_always --no-startup-id setxkbmap us -variant altgr-intl

bar {
    position top
    status_command i3status-rs
    colors {
        background $theme_bg
        statusline $theme_fg
        focused_workspace $theme_accent $theme_accent $theme_on_accent
        inactive_workspace $theme_bg $theme_bg $theme_fg
    }
}

# Monitores e ajustes desta máquina (fora do git).
include ~/.config/devenv/i3-local.conf
